---
// Profile page for hallieblack.com. Netlify rewrites that domain's root here
// (see netlify.toml); inreceiptstudio.com keeps serving the gallery at /.
// Content is edited in the admin's Profile tab.
import { fetchProjects } from '../lib/content';
import { initImages, getDesktopThumbnail, getImage, getImageUrl } from '../lib/images';
import { fetchProfile, bioParagraphs, telHref, STUDIO } from '../lib/profile';
import '../styles/base/fonts.css';
import '../styles/base/variables.css';
import '../styles/profile.css';

await initImages();
const [projects, profile] = await Promise.all([fetchProjects(), fetchProfile()]);

const SITE_URL = 'https://hallieblack.com/';
const { name, role, location, email, phone, cv } = profile;
const bio = bioParagraphs(profile.bio);
const roleLine = [role, location].filter(Boolean).join(', ');
const sections = cv.filter(section => section.entries.length);

// Lead image for the studio link: the chosen project, else the top-ranked
// big project
const bigProjects = projects
  .filter(p => p.category === 'big' && p.thumbnail)
  .sort((a, b) => a.rank - b.rank);
const featured = bigProjects.find(p => p.id === profile.featuredProjectId) ?? bigProjects[0];
const thumb = featured ? getDesktopThumbnail(featured.thumbnail, 'big') : null;
const image = thumb?.src ? thumb : null;

// Portrait: a library image chosen in the admin, else the built-in photo.
// Square either way; library images are cropped around their focal point.
const PORTRAIT_WIDTHS = [300, 450, 600, 800];
const PORTRAIT_SIZES = '(min-width: 768px) 16vw, 40vw';
const libraryPortrait = profile.portraitImageId ? getImage(profile.portraitImageId) : null;
const portrait = libraryPortrait
  ? {
      src: getImageUrl(profile.portraitImageId, { width: 600, ratio: '1x1', fit: 'cover' }),
      srcset: PORTRAIT_WIDTHS
        .map(w => `${getImageUrl(profile.portraitImageId, { width: w, ratio: '1x1', fit: 'cover' })} ${w}w`)
        .join(', '),
      alt: libraryPortrait.alt || `Portrait of ${name}`,
    }
  : {
      src: '/images/hallie-portrait-800.webp',
      srcset: '/images/hallie-portrait-400.webp 400w, /images/hallie-portrait-800.webp 800w',
      alt: `Portrait of ${name}`,
    };

const description = bio[0] || `${name}${roleLine ? `, ${roleLine}` : ''}.`;

// Link previews show the portrait, at its largest rendition
const largest = portrait.srcset.split(', ').at(-1)?.split(' ')[0] ?? portrait.src;
const shareImage = new URL(largest, SITE_URL).href;

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: SITE_URL,
  image: shareImage,
  jobTitle: role || undefined,
  email: email ? `mailto:${email}` : undefined,
  telephone: phone || undefined,
  worksFor: { '@type': 'Organization', name: STUDIO.name, url: STUDIO.url },
}).replace(/</g, '\\u003c');

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" href="/hallie-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/AkkuratLLTT-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/AkkuratLLTT-Light.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={portrait.alt} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={personSchema} />
  </head>
  <body class="profile">
    <div class="profile__rule profile__rule--left" aria-hidden="true"></div>
    <div class="profile__rule profile__rule--right" aria-hidden="true"></div>

    <main class="profile__main">
      <header class="profile__header">
        <img
          class="profile__portrait"
          src={portrait.src}
          srcset={portrait.srcset}
          sizes={PORTRAIT_SIZES}
          width="800"
          height="800"
          alt={portrait.alt}
          fetchpriority="high"
        />
        <div class="profile__intro">
          <h1 class="profile__name">{name}</h1>
          {roleLine && <p class="profile__role">{roleLine}</p>}
          {(email || phone) && (
            <ul class="profile__contact" aria-label="Contact">
              {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
              {phone && <li><a href={telHref(phone)}>{phone}</a></li>}
            </ul>
          )}
        </div>
      </header>

      {bio.length > 0 && (
        <section class="profile__bio" aria-label="About">
          {bio.map(paragraph => <p>{paragraph}</p>)}
        </section>
      )}

      <a class:list={['studio-link', { 'studio-link--text-only': !image }]} href={STUDIO.url}>
        {image && (
          <span class="studio-link__frame">
            <img
              class="studio-link__image"
              src={image.src}
              srcset={image.srcset}
              sizes="(min-width: 768px) 20vw, calc(100vw - 2rem)"
              width={image.width}
              height={image.height}
              alt=""
              data-thumbhash={image.thumbhash || undefined}
              style={image.placeholderStyle}
            />
          </span>
        )}
        <span class="studio-link__label">
          <span class="studio-link__kicker">Studio</span>
          <span class="studio-link__name">{STUDIO.name.toUpperCase()}</span>
          <span class="studio-link__tagline">{STUDIO.tagline}</span>
          <span class="studio-link__url">{STUDIO.urlDisplay}<span class="studio-link__arrow" aria-hidden="true"> &rarr;</span></span>
        </span>
      </a>

      {sections.length > 0 && (
        <section class="profile__cv" aria-label="CV">
          {sections.map(section => (
            <div class="cv-section">
              {section.heading && <h2 class="cv-section__heading">{section.heading}</h2>}
              <ul class="cv-section__list">
                {section.entries.map(entry => (
                  <li class="cv-entry">
                    <span class="cv-entry__years">{entry.years}</span>
                    <span class="cv-entry__title">{entry.title}</span>
                    {entry.detail && <span class="cv-entry__detail">{entry.detail}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}

      <footer class="profile__footer">
        <span>&copy; {new Date().getFullYear()} {name}</span>
      </footer>
    </main>

    <aside class="profile__sidebar" aria-hidden="true">
      <span class="profile__sidebar-title" style={`--chars: ${Math.max(name.length, 4)}`}>{name.toUpperCase()}</span>
    </aside>

    <script src="../scripts/placeholders.ts"></script>
  </body>
</html>
