---
import {
  getMobileThumbnail,
  getDesktopThumbnail,
  getMobileGalleryImage,
} from '../lib/images';

interface Props {
  id: string;
  title: string;
  category: 'big' | 'small';
  thumbnail: string;
  shortDescription: string;
  fullDescription: string;
  images: string[];
  year?: string;
  location?: string;
  type?: string;
  isFirst?: boolean;
  // Cards render twice — once in the mobile rows, once in the desktop
  // columns. Each copy only ever displays in its own breakpoint, so it only
  // carries that context's srcset and markup. Desktop panel content is not
  // duplicated here at all; it lives in the per-project JSON emitted once by
  // Gallery.astro.
  variant: 'mobile' | 'desktop';
}

const { id, title, category, thumbnail, shortDescription, fullDescription, images, year, location, type, isFirst = false, variant } = Astro.props;

const thumb = variant === 'mobile'
  ? getMobileThumbnail(thumbnail, category)
  : getDesktopThumbnail(thumbnail, category);

// Media query for the breakpoint where this copy of the card is hidden
const hiddenMedia = variant === 'mobile' ? '(min-width: 768px)' : '(max-width: 767px)';
const BLANK_PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

// Desktop column thumbnails are width: auto inside a shrink-to-fit box, so
// they'd be zero-width until the file arrives. The ratio lets the CSS give
// them their final size up front (see project-card.css).
const thumbStyle = [
  thumb.placeholderStyle,
  variant === 'desktop' && thumb.width && thumb.height
    ? `--aspect: ${(thumb.width / thumb.height).toFixed(4)}`
    : '',
].filter(Boolean).join('; ');

// Expanded gallery is a mobile-only feature
const mobileGalleryImages = variant === 'mobile'
  ? images.map(imgId => ({ id: imgId, ...getMobileGalleryImage(imgId) }))
  : [];
---

<article class="project-card" data-project-id={id}>
  <div class="project-card__inner">
    <div class="project-card__image-container">
      {/* Both layouts are in the DOM; the eager first card of the hidden one
          would still download. At the other breakpoint it gets a 1px blank. */}
      <picture>
        {isFirst && <source media={hiddenMedia} srcset={BLANK_PIXEL} />}
        <img
          class="project-card__image"
          src={thumb.src}
          srcset={thumb.srcset}
          sizes={thumb.sizes}
          alt={thumb.alt || title}
          width={thumb.width || undefined}
          height={thumb.height || undefined}
          data-thumbhash={thumb.thumbhash || undefined}
          style={thumbStyle || undefined}
          loading={isFirst ? "eager" : "lazy"}
          fetchpriority={isFirst ? "high" : "auto"}
          data-thumbnail-id={thumbnail}
        />
      </picture>
    </div>
    <div class="project-card__content">
      <h2 class="project-card__title">{title}</h2>
      <p class="project-card__description">{shortDescription}</p>
    </div>
  </div>

  {/* Mobile: preloaded project content (hidden until clicked) */}
  {variant === 'mobile' && (
    <div class="project-card__expanded">
      <button class="project-card__close" aria-label="Close">&times;</button>
      <div class="project-card__expanded-content">
        <div class="project-card__expanded-meta">
          <div class="project-card__expanded-meta-item">
            <span class="project-card__expanded-meta-label">Year</span>
            <span class="project-card__expanded-meta-value">{year || '—'}</span>
          </div>
          <div class="project-card__expanded-meta-item">
            <span class="project-card__expanded-meta-label">Location</span>
            <span class="project-card__expanded-meta-value">{location || '—'}</span>
          </div>
          <div class="project-card__expanded-meta-item">
            <span class="project-card__expanded-meta-label">Type</span>
            <span class="project-card__expanded-meta-value">{type || '—'}</span>
          </div>
        </div>
        <p class="project-card__expanded-description">{fullDescription}</p>
        <div class="project-card__expanded-gallery">
          {mobileGalleryImages.map((img) => (
            <img
              src={img.src}
              srcset={img.srcset}
              sizes={img.sizes}
              alt={img.alt}
              width={img.width || undefined}
              height={img.height || undefined}
              data-thumbhash={img.thumbhash || undefined}
              style={img.placeholderStyle || undefined}
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </div>
  )}
</article>
