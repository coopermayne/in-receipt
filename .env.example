# Copy to .env and fill in. Never commit the filled-in file.

# ---- Site build (root package) ----
# Origin of the self-hosted admin app, no trailing slash.
# The Astro build fetches <CONTENT_API_URL>/api/content at build time.
CONTENT_API_URL=https://admin.example.com

# Optional. Where /img/... is served from, if not the same host as the API.
# MEDIA_BASE_URL=https://media.example.com

# ---- Admin app (admin/) ----
# Where the SQLite database, image originals and derivative cache live.
# Must point at a persistent volume in production.
DATA_DIR=/data

ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

# Netlify publish button + deploy status
NETLIFY_BUILD_HOOK=
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
